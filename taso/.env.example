PORT=3000
HOST=0.0.0.0

# AI providers are disabled until their key is configured.
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
AZURE_AI_API_KEY=
OPENAI_API_KEY=

# Zero-trust data classification. External providers default to public-only.
# Promote only after the provider has been reviewed for the intended data class.
# TASO_PROVIDER_NVIDIA_DATA=public,private_code
# TASO_PROVIDER_GROQ_DATA=public
# TASO_PROVIDER_GEMINI_DATA=public
# TASO_PROVIDER_CLOUDFLARE_DATA=public
# TASO_PROVIDER_AZURE_DATA=public,private_code
# TASO_PROVIDER_OPENAI_DATA=public,private_code

# Realtime voice is a separate, paid lane. Both gates must be explicitly enabled.
# The standard API key remains server-side; it is never exposed to the browser.
TASO_VOICE_REALTIME_ENABLED=false
TASO_VOICE_REALTIME_PAID_ALLOWED=false
TASO_VOICE_REALTIME_API_KEY=
TASO_VOICE_REALTIME_MODEL=gpt-realtime-2.1-mini
TASO_VOICE_REALTIME_VOICE=marin
TASO_VOICE_REALTIME_BASE_URL=https://api.openai.com
# Optional privacy-preserving workspace safety identifier salt.
TASO_VOICE_SAFETY_SALT=

# Local mock is only for tests/dev and never for production decisions.
TASO_ALLOW_MOCK_PROVIDER=false
